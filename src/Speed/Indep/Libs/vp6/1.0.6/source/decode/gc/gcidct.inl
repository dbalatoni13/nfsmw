void IDct1_GC(short *InputData, short *QuantMatrix, short *OutputData) {
    unsigned int *dest = (unsigned int *)OutputData;
    unsigned int out;
    int i;

    out = (InputData[0] * QuantMatrix[0] + 15) >> 5;
    out = (out << 16) | (out & 0xffff);
    for (i = 8; i; i--) {
        dest[0] = out;
        dest[1] = out;
        dest[2] = out;
        dest[3] = out;
        dest += 4;
    }
}

