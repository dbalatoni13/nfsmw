+	GNU_SRC_INFO(0x8010),
+	GNU_MAC_INFO(0x8020),
+	GNU_SRC_COORDS(0x8030),
+	GNU_BODY_BEGIN(0x8040),
+	GNU_BODY_END(0x8050),
